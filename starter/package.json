{
  "name": "framework-b-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:e2e": "node scripts/e2e.mjs",
    "deploy": "astro build && wrangler deploy",
    "qa": "node scripts/qa.mjs",
    "test:live-lead": "node scripts/live-lead.mjs"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/vite": "4.3.3",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.5.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "wrangler": "4.152.0"
  }
}

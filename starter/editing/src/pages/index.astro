---
// Home page with client editing on (installed from editing/ by scripts/editing.mjs). The sections come from the
// EmDash page "home" (field "sections"), rendered by the same section library as a static site. Until an editor
// publishes that page, the sections in src/content/home.json are shown.
import { getEmDashEntry } from "emdash";
import Base from "../layouts/Base.astro";
import Sections from "../sections/Sections.astro";
import fallback from "../content/home.json";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const sections = page?.data.sections?.length ? page.data.sections : fallback.sections;
---
<Base bleed title={page?.data.title && page.data.title !== "Home" ? page.data.title : undefined}>
  <Sections sections={sections} />
</Base>

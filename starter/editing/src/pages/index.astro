---
// Home page with client editing on (installed from editing/ by scripts/editing.mjs). The sections come from the
// EmDash page "home" (field "sections"), rendered by the same section library as a static site. Until an editor
// publishes that page, the sections in src/content/home.json are shown (src/lib/page-content.js).
import Base from "../layouts/Base.astro";
import Sections from "../sections/Sections.astro";
import { pageContent } from "../lib/page-content.js";

const page = await pageContent("home", Astro);
// The page's whole <title>, as the static home page has it, until an editor writes another title.
const title = page?.title && page.title !== "Home" ? page.title : undefined;
---
<Base bleed exactTitle={title} description={page?.description}>
  <Sections sections={page?.sections || []} />
</Base>

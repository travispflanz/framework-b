---
// Every page uses this layout. Brand values come from site.config.json only.
import config from "../../site.config.json";
import { inline } from "../sections/text.js";
import credits from "../../design/credits.json";
import "../styles/tokens.css";
import fonts from "../styles/fonts.js";
import "../sections/sections.css";
import { composition } from "../sections/design.js";

// bleed: the page is made of full-width sections (src/sections), so <main> adds no column or padding.
// exactTitle: the whole <title>, without " | <site name>" (the home page's own title from home.json).
interface Props { title?: string; exactTitle?: string; description?: string; noindex?: boolean; bleed?: boolean }
const { title, exactTitle, description = config.site.tagline, noindex = false, bleed = false } = Astro.props;
const fullTitle = exactTitle || (title ? `${title} | ${config.site.name}` : config.site.name);
// With build.format "file", Astro.url.pathname is "/book.html" (and "/index.html" for the home page) at build
// time. Workers assets redirect those to "/book" and "/", so canonical, og:url and the current nav item use the
// extensionless path the visitor actually sees.
const path = Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "") || "/";
const canonical = new URL(path, `https://${config.site.canonicalHost}`).toString();
const robots = !config.site.indexing || noindex ? "noindex" : "index, follow";
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: config.site.name,
  url: `https://${config.site.canonicalHost}`,
  ...(config.site.postalAddress ? { address: config.site.postalAddress } : {}),
};
const year = new Date().getFullYear();
// The footer links to /credits when an image from another creator needs attribution or an image was generated.
const needsCredits = (credits.images || []).some((c) => c.source === "openverse" || c.source === "stock" || (c.source === "generated" && !c.test) || (c.spot && !c.test));
// Up to two nav items may carry "cta": true (a site with two front doors, for example buyers and sellers): the
// first is the solid button, the second an outlined one, and both go in the phone action bar.
const ctas = config.nav.filter((item) => item.cta).slice(0, 2);
const cta = ctas[0];
// Phones get an app-like frame: the pages as a visible row under the header (up to 6; NN/g found hidden menus
// are used far less), and the main action in a bar at the bottom of the screen, within thumb reach, on every
// page except the one it leads to. site.phone adds a call button beside it.
const pageLinks = config.nav.filter((item) => !item.cta);
const showPageRow = pageLinks.length > 0 && pageLinks.length <= 6;
const barCtas = ctas.filter((c) => path !== c.href);
const actionBar = barCtas.length > 0;
const phone = config.site.phone ? String(config.site.phone) : "";
// The logo (scripts/logo.mjs pick writes it and sets site.logo); otherwise the name in the display font.
const logo = config.site.logo || "";
// A kit made by scripts/logo.mjs also has a 96 px PNG favicon: Google Search lists raster formats for favicons, not SVG.
const logoKit = Object.values(import.meta.glob("../../design/brand/logo.json", { eager: true, import: "default" }))[0];
// The logo's size in the header (composition.logo in DESIGN.md; docs/SPEC.md section 12, "Logo size"): never shorter
// than the buttons beside it or in the phone bar (48 px), which the QA gate checks. "large" is 56 px on phones and
// 72 px from tablet width; "masthead" puts it on a row of its own, as wide as the content column, above the links.
const logoSize = composition.logo || "standard";
const masthead = !!logo && logoSize === "masthead";
const logoAspect = Number(logoKit?.aspect) > 0 ? Number(logoKit.aspect) : 160 / 36;
const logoClass = masthead ? "block h-auto w-full" : logoSize === "large" ? "h-14 w-auto md:h-18" : "h-12 w-auto";
// --header-height: the header's height for this logo size, for a hero that fills the first screen less the header
// (calc(100svh - var(--header-height))). The header row is 0.75 rem above and below its tallest item, plus a 1 px rule.
const row = (item) => `calc(${item} + 1.5rem + 1px)`;
const headerCss = masthead
  ? `:root { --header-height: calc(1rem + (100vw - 2 * var(--spacing-gutter)) / ${logoAspect.toFixed(4)} + ${actionBar ? "1px" : "4.5rem + 1px"}); }
@media (min-width: 640px) { :root { --header-height: calc(1rem + min(var(--container-content), 100vw - 2 * var(--spacing-gutter)) / ${logoAspect.toFixed(4)} + 4.5rem + 1px); } }
@media (min-width: 768px) { :root { --header-height: calc(1.5rem + min(var(--container-content), 100vw - 2 * var(--spacing-gutter)) / ${logoAspect.toFixed(4)} + 4.5rem + 1px); } }`
  : logoSize === "large"
    ? `:root { --header-height: ${row("3.5rem")}; } @media (min-width: 768px) { :root { --header-height: ${row("4.5rem")}; } }`
    : `:root { --header-height: ${row("3rem")}; }`;
// Optional footer: a short line about the business and link columns ({ note, columns: [{ title, links }] }).
const footer = config.footer || {};
const footerColumns = (footer.columns || []).filter((c) => c?.links?.length);
// The footer ends on the logo across the content width (a "wordmark footer": the brand as the page's last word;
// https://pixelgrade.com/pattern-language/wordmark-footer/ and https://www.wix.com/studio/blog/big-website-footers,
// checked 2026-11-05), unless composition.footer is "plain". On phones the link columns sit two to a row with 44 px
// tap targets, and the bottom row leaves out Privacy when a column already links it.
const wordmark = !!logo && composition.footer !== "plain";
const privacyInColumns = footerColumns.some((c) => c.links.some((l) => l.href === "/privacy"));
---
<!doctype html>
<html
  lang={config.site.locale?.split("-")[0] || "en"}
  data-cards={composition.cards}
  data-image-shape={composition.imageShape}
  data-density={composition.density}
  data-motion={composition.motion}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {logo && logoKit && <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />}
    {logo && <link rel="apple-touch-icon" href="/apple-touch-icon.png" />}
    {logo && <link rel="manifest" href="/manifest.webmanifest" />}
    {logo && <meta property="og:image" content={new URL("/og.png", `https://${config.site.canonicalHost}`).toString()} />}
    {composition.motion !== "none" && <style is:inline set:html={"@media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }"} />}
    <style is:inline set:html={headerCss} />
    {fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script src="../scripts/attribution.js"></script>
  </head>
  <body class:list={{ "max-sm:pb-24": actionBar }}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:bg-[var(--color-bg)] focus:p-2">Skip to content</a>
    <header class="border-b border-[var(--color-line)] px-[var(--spacing-gutter)]">
      {masthead && (
        <a href="/" class="mx-auto block w-full max-w-[var(--container-content)] pt-4 no-underline md:pt-6">
          <img src={logo} alt={config.site.name} class={logoClass} width={Math.round(48 * logoAspect)} height="48" />
        </a>
      )}
      <nav aria-label="Main" class:list={["mx-auto flex w-full max-w-[var(--container-content)] items-center gap-4 py-3", masthead ? ["justify-end", { "max-sm:hidden": actionBar }] : "min-h-16 justify-between"]}>
        {!masthead && (
          <a href="/" class="font-display text-lg font-bold text-[var(--color-ink)] no-underline">
            {logo ? <img src={logo} alt={config.site.name} class={logoClass} width={Math.round(48 * logoAspect)} height="48" /> : config.site.name}
          </a>
        )}
        <ul class="flex items-center gap-6">
          {/* On wide screens every link shows; on phones the pages move to the row below and the main action to the
              bar at the bottom, so the header keeps just the name. */}
          {config.nav.map((item) => (
            <li class:list={[{ "hidden md:block": !item.cta, "max-sm:hidden": item.cta && actionBar }]}>
              <a
                href={item.href}
                aria-current={path === item.href ? "page" : undefined}
                class:list={["whitespace-nowrap", {
                  "button-primary inline-flex min-h-11 items-center no-underline": item.cta && item === cta,
                  "inline-flex min-h-11 items-center rounded-[var(--radius-control)] border border-[var(--color-accent)] px-4 text-label text-[var(--color-accent)] no-underline": item.cta && item !== cta,
                }]}
              >{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      {showPageRow && (
        <nav aria-label="Pages" class="-mx-[var(--spacing-gutter)] overflow-x-auto border-t border-[var(--color-line)] md:hidden">
          <ul class="flex gap-6 px-[var(--spacing-gutter)] py-2 text-sm whitespace-nowrap">
            {pageLinks.map((item) => (
              <li><a href={item.href} aria-current={path === item.href ? "page" : undefined} class="inline-flex min-h-11 items-center">{item.label}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </header>
    <main id="main" class:list={["flex-1", bleed ? "w-full" : "mx-auto w-full max-w-[var(--container-content)] px-[var(--spacing-gutter)] py-10"]}>
      <slot />
    </main>
    <footer class="border-t border-[var(--color-line)] px-[var(--spacing-gutter)]">
      {(footer.note || footerColumns.length > 0) && (
        <div class:list={["mx-auto grid max-w-[var(--container-content)] grid-cols-2 gap-x-8 gap-y-10 pt-12 text-sm text-[var(--color-ink-muted)]", ["md:grid-cols-[2fr]", "md:grid-cols-[2fr_1fr]", "md:grid-cols-[2fr_1fr_1fr]", "md:grid-cols-[2fr_1fr_1fr_1fr]"][Math.min(footerColumns.length, 3)]]}>
          <div class="col-span-2 grid content-start gap-2 md:col-span-1">
            <p class="font-display text-title text-[var(--color-ink)]">{config.site.name}</p>
            {footer.note && <p class="max-w-(--container-prose)" set:html={inline(footer.note)} />}
          </div>
          {footerColumns.map((c, i) => (
            <nav aria-labelledby={`footer-col-${i}`}>
              <p id={`footer-col-${i}`} class="mb-2 font-semibold text-[var(--color-ink)]">{c.title}</p>
              <ul class="grid gap-1 md:gap-2">{c.links.map((l) => <li><a href={l.href} class="inline-flex min-h-11 items-center md:min-h-0">{l.label}</a></li>)}</ul>
            </nav>
          ))}
        </div>
      )}
      {wordmark && (
        <a href="/" class="mx-auto block max-w-[var(--container-content)] pt-12 no-underline" aria-label={`${config.site.name}: home`}>
          <img src={logo} alt="" class="block h-auto w-full" width={Math.round(48 * logoAspect)} height="48" loading="lazy" decoding="async" />
        </a>
      )}
      <div class="mx-auto flex max-w-[var(--container-content)] flex-wrap justify-between gap-4 py-6 text-sm text-[var(--color-ink-muted)]">
        <p>© {year} {config.site.name}{config.site.postalAddress ? ` · ${config.site.postalAddress}` : ""}</p>
        {footer.legal && <p class="w-full max-w-(--container-prose)" set:html={inline(footer.legal)} />}
        <p class="flex gap-4">{needsCredits && <a href="/credits">Website assets</a>}{!privacyInColumns && <a href="/privacy">Privacy</a>}</p>
      </div>
    </footer>
    {actionBar && (
      <div class="fixed inset-x-0 bottom-0 z-40 flex gap-3 border-t border-[var(--color-line)] bg-[var(--color-bg)] px-[var(--spacing-gutter)] pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:hidden">
        {phone && <a href={`tel:${phone.replace(/[^+\d]/g, "")}`} class="inline-flex min-h-12 items-center justify-center rounded-[var(--radius-control)] border border-[var(--color-field)] px-4 font-semibold no-underline">Call</a>}
        {barCtas.map((c, i) => (
          <a href={c.href} class:list={["inline-flex min-h-12 flex-1 items-center justify-center text-center no-underline", c === cta || barCtas.length === 1 ? "button-primary" : "rounded-[var(--radius-control)] border border-[var(--color-accent)] px-3 text-label text-[var(--color-accent)]"]}>{c.label}</a>
        ))}
      </div>
    )}
  </body>
</html>

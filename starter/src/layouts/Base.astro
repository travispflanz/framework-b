---
// Every page uses this layout. Brand values come from site.config.json only.
import config from "../../site.config.json";
import { inline } from "../sections/text.js";
import credits from "../../design/credits.json";
import "../styles/tokens.css";
import fonts from "../styles/fonts.js";
import "../sections/sections.css";
import { composition } from "../sections/design.js";

// bleed: the page is made of full-width sections (src/sections), so <main> adds no column or padding.
interface Props { title?: string; description?: string; noindex?: boolean; bleed?: boolean }
const { title, description = config.site.tagline, noindex = false, bleed = false } = Astro.props;
const fullTitle = title ? `${title} | ${config.site.name}` : config.site.name;
// With build.format "file", Astro.url.pathname is "/book.html" (and "/index.html" for the home page) at build
// time. Workers assets redirect those to "/book" and "/", so canonical, og:url and the current nav item use the
// extensionless path the visitor actually sees.
const path = Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "") || "/";
const canonical = new URL(path, `https://${config.site.canonicalHost}`).toString();
const robots = !config.site.indexing || noindex ? "noindex" : "index, follow";
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: config.site.name,
  url: `https://${config.site.canonicalHost}`,
  ...(config.site.postalAddress ? { address: config.site.postalAddress } : {}),
};
const year = new Date().getFullYear();
// The footer links to /credits when an image from another creator needs attribution or an image was generated.
const needsCredits = (credits.images || []).some((c) => c.source === "openverse" || c.source === "stock" || (c.source === "generated" && !c.test));
const cta = config.nav.find((item) => item.cta);
// Phones get an app-like frame: the pages as a visible row under the header (up to 6; NN/g found hidden menus
// are used far less), and the main action in a bar at the bottom of the screen, within thumb reach, on every
// page except the one it leads to. site.phone adds a call button beside it.
const pageLinks = config.nav.filter((item) => !item.cta);
const showPageRow = pageLinks.length > 0 && pageLinks.length <= 6;
const actionBar = !!cta && path !== cta.href;
const phone = config.site.phone ? String(config.site.phone) : "";
// The logo (scripts/brand-kit.mjs writes it and sets site.logo); otherwise the name in the display font.
const logo = config.site.logo || "";
// Optional footer: a short line about the business and link columns ({ note, columns: [{ title, links }] }).
const footer = config.footer || {};
const footerColumns = (footer.columns || []).filter((c) => c?.links?.length);
---
<!doctype html>
<html
  lang={config.site.locale?.split("-")[0] || "en"}
  data-cards={composition.cards}
  data-image-shape={composition.imageShape}
  data-density={composition.density}
  data-motion={composition.motion}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {logo && <link rel="apple-touch-icon" href="/apple-touch-icon.png" />}
    {logo && <link rel="manifest" href="/manifest.webmanifest" />}
    {logo && <meta property="og:image" content={new URL("/og.png", `https://${config.site.canonicalHost}`).toString()} />}
    {composition.motion !== "none" && <style is:inline set:html={"@media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }"} />}
    {fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script src="../scripts/attribution.js"></script>
  </head>
  <body class:list={{ "max-sm:pb-24": actionBar }}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:bg-[var(--color-bg)] focus:p-2">Skip to content</a>
    <header class="border-b border-[var(--color-line)] px-[var(--spacing-gutter)]">
      <nav aria-label="Main" class="mx-auto flex min-h-16 w-full max-w-[var(--container-content)] items-center justify-between gap-4 py-3">
        <a href="/" class="font-display text-lg font-bold text-[var(--color-ink)] no-underline">
          {logo ? <img src={logo} alt={config.site.name} class="h-9 w-auto" width="160" height="36" /> : config.site.name}
        </a>
        <ul class="flex items-center gap-6">
          {/* On wide screens every link shows; on phones the pages move to the row below and the main action to the
              bar at the bottom, so the header keeps just the name. */}
          {config.nav.map((item) => (
            <li class:list={[{ "hidden md:block": !item.cta, "max-sm:hidden": item.cta && actionBar }]}>
              <a
                href={item.href}
                aria-current={path === item.href ? "page" : undefined}
                class:list={["whitespace-nowrap", { "button-primary inline-flex min-h-11 items-center no-underline": item.cta }]}
              >{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      {showPageRow && (
        <nav aria-label="Pages" class="-mx-[var(--spacing-gutter)] overflow-x-auto border-t border-[var(--color-line)] md:hidden">
          <ul class="flex gap-6 px-[var(--spacing-gutter)] py-2 text-sm whitespace-nowrap">
            {pageLinks.map((item) => (
              <li><a href={item.href} aria-current={path === item.href ? "page" : undefined} class="inline-flex min-h-11 items-center">{item.label}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </header>
    <main id="main" class:list={["flex-1", bleed ? "w-full" : "mx-auto w-full max-w-[var(--container-content)] px-[var(--spacing-gutter)] py-10"]}>
      <slot />
    </main>
    <footer class="border-t border-[var(--color-line)] px-[var(--spacing-gutter)]">
      {(footer.note || footerColumns.length > 0) && (
        <div class:list={["mx-auto grid max-w-[var(--container-content)] gap-8 pt-10 text-sm text-[var(--color-ink-muted)]", ["md:grid-cols-[2fr]", "md:grid-cols-[2fr_1fr]", "md:grid-cols-[2fr_1fr_1fr]", "md:grid-cols-[2fr_1fr_1fr_1fr]"][Math.min(footerColumns.length, 3)]]}>
          <div class="grid content-start gap-2">
            <p class="font-display text-title text-[var(--color-ink)]">{config.site.name}</p>
            {footer.note && <p class="max-w-prose" set:html={inline(footer.note)} />}
          </div>
          {footerColumns.map((c, i) => (
            <nav aria-labelledby={`footer-col-${i}`}>
              <p id={`footer-col-${i}`} class="mb-2 font-semibold text-[var(--color-ink)]">{c.title}</p>
              <ul class="grid gap-2">{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
            </nav>
          ))}
        </div>
      )}
      <div class="mx-auto flex max-w-[var(--container-content)] flex-wrap justify-between gap-4 py-6 text-sm text-[var(--color-ink-muted)]">
        <p>© {year} {config.site.name}{config.site.postalAddress ? ` · ${config.site.postalAddress}` : ""}</p>
        {footer.legal && <p class="w-full max-w-prose" set:html={inline(footer.legal)} />}
        <p class="flex gap-4">{needsCredits && <a href="/credits">Image credits</a>}<a href="/privacy">Privacy</a></p>
      </div>
    </footer>
    {actionBar && (
      <div class="fixed inset-x-0 bottom-0 z-40 flex gap-3 border-t border-[var(--color-line)] bg-[var(--color-bg)] px-[var(--spacing-gutter)] pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:hidden">
        {phone && <a href={`tel:${phone.replace(/[^+\d]/g, "")}`} class="inline-flex min-h-12 items-center justify-center rounded-[var(--radius-control)] border border-[var(--color-field)] px-4 font-semibold no-underline">Call</a>}
        <a href={cta.href} class="button-primary inline-flex min-h-12 flex-1 items-center justify-center no-underline">{cta.label}</a>
      </div>
    )}
  </body>
</html>

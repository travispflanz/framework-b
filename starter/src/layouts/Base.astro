---
// Every page uses this layout. Brand values come from site.config.json only.
import config from "../../site.config.json";
import "../styles/tokens.css";

interface Props { title?: string; description?: string; noindex?: boolean }
const { title, description = config.site.tagline, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${config.site.name}` : config.site.name;
const canonical = new URL(Astro.url.pathname, `https://${config.site.canonicalHost}`).toString();
const robots = !config.site.indexing || noindex ? "noindex" : "index, follow";
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: config.site.name,
  url: `https://${config.site.canonicalHost}`,
  ...(config.site.postalAddress ? { address: config.site.postalAddress } : {}),
};
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={config.site.locale?.split("-")[0] || "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script src="../scripts/attribution.js"></script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:bg-[var(--color-bg)] focus:p-2">Skip to content</a>
    <header class="border-b border-[var(--color-line)]">
      <nav aria-label="Main" class="mx-auto flex max-w-[var(--container-content)] flex-wrap items-center justify-between gap-4 px-[var(--spacing-gutter)] py-4">
        <a href="/" class="font-semibold text-[var(--color-ink)] no-underline">{config.site.name}</a>
        <ul class="flex gap-6">
          {config.nav.map((item) => (
            <li><a href={item.href} aria-current={Astro.url.pathname === item.href ? "page" : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main" class="mx-auto w-full max-w-[var(--container-content)] flex-1 px-[var(--spacing-gutter)] py-10">
      <slot />
    </main>
    <footer class="border-t border-[var(--color-line)]">
      <div class="mx-auto flex max-w-[var(--container-content)] flex-wrap justify-between gap-4 px-[var(--spacing-gutter)] py-6 text-sm text-[var(--color-ink-muted)]">
        <p>© {year} {config.site.name}{config.site.postalAddress ? ` · ${config.site.postalAddress}` : ""}</p>
        <a href="/privacy">Privacy</a>
      </div>
    </footer>
  </body>
</html>

---
// Every src/content/<slug>.json except home.json is a page at /<slug>, built from the section library.
// A page file has "title", optional "description", optional "noindex" (true for thanks pages and the like: kept out
// of search results and the sitemap), and "sections" (the first one a hero).
// With client editing on, editing/src/pages/[page].astro replaces this file and renders every page on request from
// EmDash, with these files as the fallback.
export const prerender = true;
import ContentPage from "../components/ContentPage.astro";
import { fileContent, fileSlugs, OWN_ROUTE } from "../lib/page-content.js";

export function getStaticPaths() {
  // home, privacy, not-found and contact have their own routes (index.astro, privacy.astro, 404.astro, contact.astro).
  return fileSlugs()
    .filter((slug) => !OWN_ROUTE.includes(slug))
    .map((slug) => ({ params: { page: slug }, props: { page: fileContent(slug) } }));
}

const { page } = Astro.props;
---
<ContentPage page={page} />

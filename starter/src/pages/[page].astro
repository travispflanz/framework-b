---
// Every src/content/<slug>.json except home.json is a page at /<slug>, built from the section library.
// A page file has "title", optional "description", and "sections" (the first one a hero).
// With client editing on, these pages stay static: only the home page comes from EmDash.
export const prerender = true;
import Base from "../layouts/Base.astro";
import Sections from "../sections/Sections.astro";

export function getStaticPaths() {
  const files = import.meta.glob<{ default: { title: string; description?: string; sections: Array<Record<string, any>> } }>("../content/*.json", { eager: true });
  return Object.entries(files)
    .map(([path, mod]) => ({ slug: path.split("/").pop()!.replace(/\.json$/, ""), page: mod.default }))
    .filter(({ slug }) => slug !== "home")
    .map(({ slug, page }) => ({ params: { page: slug }, props: { page } }));
}

const { page } = Astro.props;
---
<Base title={page.title} description={page.description} bleed>
  <Sections sections={page.sections} />
</Base>

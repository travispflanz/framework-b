---
// Every src/content/<slug>.json except home.json is a page at /<slug>, built from the section library.
// A page file has "title", optional "description", optional "noindex" (true for thanks pages and the like: kept out
// of search results and the sitemap), and "sections" (the first one a hero).
// With client editing on, these pages stay static: only the home page comes from EmDash.
export const prerender = true;
import Base from "../layouts/Base.astro";
import Sections from "../sections/Sections.astro";

export function getStaticPaths() {
  const files = import.meta.glob<{ default: { title: string; description?: string; noindex?: boolean; sections: Array<Record<string, any>> } }>("../content/*.json", { eager: true });
  return Object.entries(files)
    .map(([path, mod]) => ({ slug: path.split("/").pop()!.replace(/\.json$/, ""), page: mod.default }))
    .filter(({ slug }) => !["home", "privacy", "not-found"].includes(slug)) // those two replace privacy.astro and 404.astro
    .map(({ slug, page }) => ({ params: { page: slug }, props: { page } }));
}

const { page } = Astro.props;
---
<Base title={page.title} description={page.description} noindex={page.noindex === true} bleed>
  <Sections sections={page.sections} />
  {page.noindex === true && (
    <>
      <p id="file-failed" class="mx-auto hidden max-w-[var(--container-content)] px-[var(--spacing-gutter)] pb-10 text-[var(--color-error)]">
        Your message was saved, but your file didn't upload. Reply to our email and attach it there.
      </p>
      <script is:inline>if (location.hash === "#file-failed") document.getElementById("file-failed").classList.remove("hidden");</script>
    </>
  )}
</Base>

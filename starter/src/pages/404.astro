---
// The 404 page. src/content/not-found.json, when present, replaces the default with the owner's own words. The link
// sits beside the title on wide screens, so a short title doesn't leave the right of the page empty.
import Base from "../layouts/Base.astro";
import PageTitle from "../components/PageTitle.astro";
import Sections from "../sections/Sections.astro";
import { pageContent } from "../lib/page-content.js";
// With client editing on, an editor's page "not-found" in EmDash comes first (and this page is rendered on request).
const custom: any = await pageContent("not-found", Astro);
---
{custom ? (
<Base title={custom.title || "Page not found"} description={custom.description} noindex bleed>
  <Sections sections={custom.sections} />
</Base>
) : (
<Base title="Page not found" noindex>
  <div class="grid gap-4 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end lg:gap-x-16">
    <PageTitle>Page not found</PageTitle>
    <p><a href="/">Go to the home page</a></p>
  </div>
</Base>
)}

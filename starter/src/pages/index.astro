---
// Home page: the sections in src/content/home.json, rendered by the section library (src/sections).
// The design phase writes the content; with client editing on, EmDash serves the same sections instead.
import Base from "../layouts/Base.astro";
import Sections from "../sections/Sections.astro";
import page from "../content/home.json";
---
<Base bleed>
  <Sections sections={page.sections} />
</Base>

---
// Generated from what the site actually collects (site.config.json), so it can't drift from the forms. A site
// whose owner has their own privacy wording puts it in src/content/privacy.json, which replaces this page. Each topic's
// heading sits beside its text on wide screens (.split-row), so the page is balanced (scripts/lib/cohesion.mjs).
import Base from "../layouts/Base.astro";
import PageTitle from "../components/PageTitle.astro";
import Sections from "../sections/Sections.astro";
import { pageContent } from "../lib/page-content.js";
// With client editing on, an editor's page "privacy" in EmDash comes first (and this page is rendered on request).
const custom: any = await pageContent("privacy", Astro);
import raw from "../../site.config.json";
import { loadConfig } from "../../core/src/config.js";
const config = loadConfig(raw);
const forms = Object.entries(config.forms);
const anyFile = forms.some(([, f]) => f.file.enabled);
const labels = [...new Set(forms.flatMap(([, f]) => f.fields.filter((x) => x.type !== "hidden").map((x) => x.label || x.name)))];
const autoReply = config.email.confirm !== "none";
---
{custom ? (
<Base title={custom.title} description={custom.description} bleed>
  <Sections sections={custom.sections} />
</Base>
) : (
<Base title="Privacy">
  <PageTitle>Privacy</PageTitle>
  <p class="mt-4 max-w-(--container-prose)">{config.site.name} collects only what you send through our forms.</p>
  <div class="mt-10 grid gap-10">
    <div class="split-row">
      <h2 class="text-xl font-semibold">What we collect</h2>
      <ul class="max-w-(--container-prose) list-disc pl-6">
        {labels.map((l) => <li>{l}</li>)}
        {anyFile && <li>Any file you choose to send us</li>}
        <li>The page you sent the form from, and how you found us (for example, a campaign link or the site that referred you)</li>
      </ul>
    </div>
    <div class="split-row">
      <h2 class="text-xl font-semibold">How we use it</h2>
      <p class="max-w-(--container-prose)">To answer you, and to send you occasional emails. Every form signs you up for those emails. Each one has an unsubscribe link, and you can unsubscribe at any time.{autoReply && " After you send a form, you get one confirmation email."}</p>
    </div>
    <div class="split-row">
      <h2 class="text-xl font-semibold">Spam protection</h2>
      <p class="max-w-(--container-prose)">Our forms use Cloudflare Turnstile to check that a person, not a bot, is sending them.</p>
    </div>
    <div class="split-row">
      <h2 class="text-xl font-semibold">Where it's kept</h2>
      <p class="max-w-(--container-prose)">Your submissions are stored with Cloudflare, which hosts this site.</p>
    </div>
    <div class="split-row">
      <h2 class="text-xl font-semibold">Questions or removal</h2>
      <p class="max-w-(--container-prose)">Reply to any email from us and ask, and we'll delete what we hold about you.</p>
    </div>
  </div>
</Base>
)}

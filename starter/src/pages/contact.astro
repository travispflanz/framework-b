---
// The contact page: the contact form under a heading. src/content/contact.json, when present, replaces it with
// sections like any other page (a hero, then a form section).
import Base from "../layouts/Base.astro";
import PageTitle from "../components/PageTitle.astro";
import Form from "../components/Form.astro";
import Sections from "../sections/Sections.astro";
const custom = Object.values(import.meta.glob<{ default: any }>("../content/contact.json", { eager: true }))[0]?.default;
---
{custom ? (
<Base title={custom.title} description={custom.description} noindex={custom.noindex === true} bleed>
  <Sections sections={custom.sections} />
</Base>
) : (
<Base title="Contact">
  <PageTitle class="mb-8">Contact</PageTitle>
  <Form id="contact" />
</Base>
)}

---
// Website assets (URL kept at /credits): every picture once, in the order the site shows them (src/lib/ai-use.js,
// docs/SPEC.md section 12, "Website assets: how AI was used"). Each entry says where the picture comes from (its
// creator, licence or rights and link; the owner's own; or the generator that made it), where it appears and what AI
// did with it, from design/credits.json and the pages' content. The logo and everything made from it is one entry.
// Then, when photographs carry a spot of colour (scripts/spot-colour.mjs), the owner's note, how it was done and the
// script and prompt to do the same; the entries above say what was coloured, so no picture is listed twice. CC BY and
// CC BY-SA require this attribution; the footer links here whenever there is something to credit.
export const prerender = true;
import Base from "../layouts/Base.astro";
import PageTitle from "../components/PageTitle.astro";
import credits from "../../design/credits.json";
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import { aiSummary, aiText, isRightsStatement, outlineText, placements, titleOf, whereText } from "../lib/ai-use.js";

const LICENSE_URL = { "cc0": "https://creativecommons.org/publicdomain/zero/1.0/", "pdm": "https://creativecommons.org/publicdomain/mark/1.0/" };
const licenceUrl = (c) => c.license_url || LICENSE_URL[String(c.license).toLowerCase()];
// Everything to list: the framework's own placeholder icon and test records are not the site's.
const all = (credits.images || []).filter((c) => !c.test && c.source !== "framework");
const fromCollection = (c) => c.source === "openverse" || c.source === "stock";
const nameOf = (c) => c.file.split("/").pop();
const sentence = (t) => { const s = String(t || "").trim(); return s ? s[0].toUpperCase() + s.slice(1) + (/[.!?]$/.test(s) ? "" : ".") : ""; };
const unique = (list) => [...new Set(list.filter(Boolean))];
// Where each picture appears, from the pages' content, the home page first.
const pageFiles = import.meta.glob<{ default: any }>("../content/*.json", { eager: true });
const pages = Object.fromEntries(Object.entries(pageFiles).map(([p, m]) => [p.split("/").pop().replace(/\.json$/, ""), m.default]).sort(([a], [b]) => Number(b === "home") - Number(a === "home")));
const placed = placements(pages);
const order = [...placed.keys()];
const withPlaces = all.map((c) => ({ ...c, places: placed.get(nameOf(c)) || [] }));
// Pictures in the order the site shows them; pictures no page uses yet come last.
const pictures = withPlaces.filter((c) => c.source !== "brand").sort((a, b) => (order.indexOf(nameOf(a)) + 1 || 1e4) - (order.indexOf(nameOf(b)) + 1 || 1e4));
const brand = withPlaces.find((c) => c.source === "brand" && /logo\.svg$/.test(c.file)) || withPlaces.find((c) => c.source === "brand");
const entries = pictures.length + (brand ? 1 : 0);
// Spot colour (docs/SPEC.md section 12, "Spot colour"): the note is the owner's brief in plain words.
const spotted = all.filter((c) => c.spot);
const chosenBy = unique(spotted.map((c) => c.spot.chosenBy));
const colours = unique(spotted.map((c) => c.spot.colour));
const dates = unique(spotted.map((c) => c.spot.date)).sort();
const aiBy = credits.aiBy || chosenBy[0] || "an AI model";
const summary = aiSummary(withPlaces.filter((c) => (Array.isArray(c.ai) && c.ai.length > 0) || c.spot || c.source === "owner").map((c) => ({ ...c, framed: c.places.some((p) => p.framed) })), { by: aiBy, heroes: pictures.some((c) => c.places.some((p) => p.where === "top of the page")) });
// public/tools/ is served as it is; the page is prerendered, so it reads the files at build time.
const tool = (f) => resolve(process.cwd(), "public/tools", f);
const prompt = existsSync(tool("spot-colour-prompt.md")) ? readFileSync(tool("spot-colour-prompt.md"), "utf8") : "";
const script = existsSync(tool("spot-colour.mjs"));
// The page is balanced on wide screens (scripts/lib/cohesion.mjs, "balance"). A few entries sit beside their heading;
// more than four set the heading above a list across the page in two columns, as a long list beside a short heading
// would open the page with one column several screens tall (Impeccable's first-viewport-column-overflow).
const group = "mt-12 grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16";
const side = "grid content-start gap-3 text-body";
const wide = entries > 4;
const entry = "lg:mb-6 lg:break-inside-avoid";
---
<Base title="Website assets" noindex>
  <!-- The title with a line beside it on wide screens, so the top of the page is balanced like the sections below. -->
  <!-- With no pictures to list, the one line still sits beside the title, so the page isn't empty on the right (a site
       with no credited images failed the balance check, 2026-11-11). -->
  <div class="grid gap-4 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:items-end lg:gap-16">
    <PageTitle>Website assets</PageTitle>
    <p class="max-w-(--container-prose) text-body text-ink-muted">{entries > 0 ? "Every picture on this site, once: where it comes from, where it appears and what was done to it." : "Every image on this site belongs to us."}</p>
  </div>
  {entries > 0 && (
    <section aria-labelledby="pictures" class={wide ? "mt-12 grid gap-6" : group}>
      <div class={wide ? "grid max-w-(--container-prose) gap-3 text-body" : side}>
        <h2 id="pictures" class="font-display text-title text-ink">The pictures</h2>
        {summary && <p class="text-ink-muted">{summary}</p>}
      </div>
      <ul class:list={["grid gap-4 text-body text-ink", wide ? "max-w-(--container-prose) lg:block lg:max-w-none lg:columns-2 lg:gap-x-16" : ""]} role="list">
        {pictures.map((c) => {
          const did = aiText(c, { places: c.places, brief: true });
          return (
            <li class={entry}>
              <strong>{sentence(c.alt || nameOf(c))}</strong>
              {c.places.length > 0 && <> Where: {whereText(c.places)}.</>}
              {" "}<span class="text-ink-muted">
                {fromCollection(c) && (
                  <>From <a href={c.url} class="underline underline-offset-2">{titleOf(c)}</a>{c.creator && ` by ${c.creator}`}.{" "}
                  {isRightsStatement(c) ? `Rights: ${sentence(c.license)}` : licenceUrl(c) ? <>Licensed under <a href={licenceUrl(c)} class="underline underline-offset-2">{c.license}</a>.</> : `Licensed under ${sentence(c.license)}`}{" "}</>
                )}
                {c.source === "owner" && <>{sentence(c.credit || "Our own photograph")}{" "}</>}
                {c.source === "generated" && <>Made with {c.model || "an image generator"}{c.created && `, ${c.created}`}, to illustrate the site: it doesn't show our own people, premises, products or work.{" "}</>}
                {did ? <>{did}{c.spot && ` ${outlineText(c)}`}</> : c.changes}
              </span>
            </li>
          );
        })}
        {brand && (
          <li class={entry}>
            <strong>The logo, and the icons and share image made from it.</strong> Where: the header of every page, the
            browser tab and link previews. <span class="text-ink-muted">{aiText(brand)}</span>
          </li>
        )}
      </ul>
    </section>
  )}
  {spotted.length > 0 && (
    <section aria-labelledby="spot" class={group}>
      <div class={side}>
        <h2 id="spot" class="font-display text-title text-ink">How the colour was added</h2>
        {credits.spotNote && <p class="text-ink">{credits.spotNote}</p>}
      </div>
      <div class="grid content-start gap-6 text-body text-ink">
        <p class="text-ink-muted">
          {chosenBy.join(" and ")} looked at each photograph and chose the object. Its outline was made with SlimSAM, a
          small Segment Anything model, picked out by its tone (lettering, neon, bulbs), or drawn as shapes by the model
          itself, piece by piece, and checked close up; each picture above says which. The colour
          ({colours.join(", ")}) is blended over the photograph's own light and shade, so nothing in a picture was drawn
          in or invented. {dates.length > 1 ? `${dates[0]} to ${dates[dates.length - 1]}` : dates[0]}.
        </p>
        {(script || prompt) && (
          <div class="grid gap-3">
            <p>Do the same with your own photographs:{script && <> <a href="/tools/spot-colour.mjs" download class="underline underline-offset-2">download the script</a></>}{script && prompt && " or"}{prompt && <> <a href="/tools/spot-colour-prompt.md" download class="underline underline-offset-2">download the prompt</a> for an AI model or agent</>}.</p>
            {prompt && (
              <details class="border-t border-line pt-3">
                <summary class="cursor-pointer font-semibold">Read the prompt</summary>
                <pre class="mt-3 max-w-full overflow-x-auto whitespace-pre-wrap text-small text-ink-muted">{prompt}</pre>
              </details>
            )}
          </div>
        )}
      </div>
    </section>
  )}
</Base>

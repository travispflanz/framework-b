---
// Renders a form from its schema in site.config.json. Every form is a sign-up form: auto opt-in (one line under the
// button) or, with optIn.mode "checkbox", a consent box before the button.
// Fields may carry "step": n to split the form into steps; validation runs per step, and form.steps[n - 1]
// ({ title, intro }) heads step n; form.note is a line under the submit button. Hints, the opt-in line, the
// consent label and the note take inline **bold**, *italic* and [links](/path). radio and checkboxes fields draw their options (grouped by option.group).
import raw from "../../site.config.json";
import { loadConfig } from "../../core/src/config.js";
import { inline } from "../sections/text.js";

// showTitle: false when the page already heads the form (the form section has its own headline).
// stepHeading: the level of the step titles (h2 when nothing above the form is an h2).
interface Props { id: string; showTitle?: boolean; stepHeading?: "h2" | "h3" }
const config = loadConfig(raw);
const { id, showTitle = true, stepHeading: StepHeading = "h3" } = Astro.props;
const form = config.forms[id];
if (!form) throw new Error(`Form "${id}" is not in site.config.json`);

const steps = [...new Set(form.fields.map((f) => f.step || 1))].sort((a, b) => a - b);
const lastStep = steps[steps.length - 1];
const fieldId = (name) => `${id}-${name}`;
// Options in their groups, in order: [[group or "", [options]], ...].
const groups = (options) => options.reduce((out, o) => {
  const g = (typeof o === "object" && o.group) || "";
  const last = out[out.length - 1];
  if (last && last[0] === g) last[1].push(o);
  else out.push([g, [o]]);
  return out;
}, []);
---
<form
  method="post"
  action={`/api/submit/${id}`}
  data-fb-form={id}
  data-steps={steps.length}
  class="grid w-full max-w-[var(--container-prose)] grid-cols-[minmax(0,1fr)] gap-6"
>
  {showTitle && form.title && <h2 class="text-2xl font-semibold">{form.title}</h2>}
  {steps.length > 1 && (
    <p class="text-sm text-[var(--color-ink-muted)]" data-fb-progress aria-live="polite">Step 1 of {steps.length}</p>
  )}

  {steps.map((step) => (
    <fieldset data-fb-step={step} hidden={step !== steps[0]} class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-5 border-0 p-0">
      <legend class="sr-only">Step {step} of {steps.length}</legend>
      {form.steps?.[steps.indexOf(step)]?.title && (
        <div class="grid gap-2">
          <StepHeading class="font-display text-title text-ink">{form.steps[steps.indexOf(step)].title}</StepHeading>
          {form.steps[steps.indexOf(step)].intro && <p class="text-sm text-[var(--color-ink-muted)]">{form.steps[steps.indexOf(step)].intro}</p>}
        </div>
      )}
      {form.fields.filter((f) => (f.step || 1) === step).map((f) => (
        f.type === "hidden" ? <input type="hidden" name={f.name} value={f.value || ""} /> :
        f.type === "radio" || f.type === "checkboxes" ? (
          <fieldset class="grid min-w-0 gap-2 border-0 p-0" data-fb-group={f.name} data-required={f.required ? "1" : undefined}
            aria-describedby={[f.hint && `${fieldId(f.name)}-hint`, `${fieldId(f.name)}-err`].filter(Boolean).join(" ")}>
            <legend class="mb-1 font-medium">{f.label}{f.required && <span aria-hidden="true"> *</span>}</legend>
            {f.hint && <p id={`${fieldId(f.name)}-hint`} class="text-sm text-[var(--color-ink-muted)]" set:html={inline(f.hint)} />}
            {groups(f.options).map(([group, options]) => (
              <div class="grid gap-2">
                {group && <p class="mt-2 text-sm font-medium text-[var(--color-ink-muted)]">{group}</p>}
                <div class="grid gap-2 sm:grid-cols-2">
                  {options.map((o) => (
                    <label class="flex items-start gap-3">
                      <input type={f.type === "radio" ? "radio" : "checkbox"} name={f.name} value={o.value ?? o} required={f.type === "radio" && f.required} class="mt-1 size-5 shrink-0" />
                      <span>{o.label ?? o}</span>
                    </label>
                  ))}
                </div>
              </div>
            ))}
            <p id={`${fieldId(f.name)}-err`} class="text-sm text-[var(--color-error)]" data-fb-error={f.name}></p>
          </fieldset>
        ) :
        f.type === "checkbox" ? (
          <div class="flex items-start gap-3">
            <input type="checkbox" id={fieldId(f.name)} name={f.name} required={f.required} aria-describedby={`${fieldId(f.name)}-err`} class="mt-1 size-5" />
            <label for={fieldId(f.name)}>{f.label}</label>
            <p id={`${fieldId(f.name)}-err`} class="text-sm text-[var(--color-error)]" data-fb-error={f.name}></p>
          </div>
        ) : (
          <div class="grid min-w-0 gap-1.5">
            <label for={fieldId(f.name)} class="font-medium">{f.label}{f.required && <span aria-hidden="true"> *</span>}</label>
            {f.hint && <p id={`${fieldId(f.name)}-hint`} class="text-sm text-[var(--color-ink-muted)]" set:html={inline(f.hint)} />}
            {f.type === "textarea" ? (
              <textarea id={fieldId(f.name)} name={f.name} rows="5" required={f.required} maxlength={f.maxLength} placeholder={f.placeholder}
                aria-describedby={[f.hint && `${fieldId(f.name)}-hint`, `${fieldId(f.name)}-err`].filter(Boolean).join(" ")}
                class="rounded-[var(--radius-control)] border border-[var(--color-field)] bg-[var(--color-bg)] p-3"></textarea>
            ) : f.type === "select" ? (
              <select id={fieldId(f.name)} name={f.name} required={f.required} aria-describedby={`${fieldId(f.name)}-err`}
                class="rounded-[var(--radius-control)] border border-[var(--color-field)] bg-[var(--color-bg)] p-3">
                <option value="">Choose…</option>
                {f.options.map((o) => <option value={o.value ?? o}>{o.label ?? o}</option>)}
              </select>
            ) : (
              <input id={fieldId(f.name)} name={f.name} type={f.type} required={f.required} maxlength={f.maxLength}
                autocomplete={f.autocomplete} placeholder={f.placeholder} inputmode={f.inputmode}
                aria-describedby={[f.hint && `${fieldId(f.name)}-hint`, `${fieldId(f.name)}-err`].filter(Boolean).join(" ")}
                class="rounded-[var(--radius-control)] border border-[var(--color-field)] bg-[var(--color-bg)] p-3" />
            )}
            <p id={`${fieldId(f.name)}-err`} class="text-sm text-[var(--color-error)]" data-fb-error={f.name}></p>
          </div>
        )
      ))}

      {step === lastStep && form.file.enabled && (
        <div class="grid min-w-0 gap-1.5">
          <label for={fieldId("file")} class="font-medium">{form.file.label || "Do you need to send us something?"}</label>
          {form.file.hint && <p id={`${fieldId("file")}-hint`} class="text-sm text-[var(--color-ink-muted)]">{form.file.hint}</p>}
          <input id={fieldId("file")} type="file" class="w-full min-w-0" data-fb-file data-max-bytes={form.file.maxBytes} accept={form.file.types.join(",")}
            aria-describedby={[form.file.hint && `${fieldId("file")}-hint`, `${fieldId("file")}-err`].filter(Boolean).join(" ")} />
          <p id={`${fieldId("file")}-err`} class="text-sm text-[var(--color-error)]" data-fb-error="file"></p>
        </div>
      )}

      {step !== lastStep ? (
        <div class="flex gap-3">
          {step !== steps[0] && <button type="button" data-fb-back class="rounded-[var(--radius-control)] border border-[var(--color-field)] px-5 py-3">Back</button>}
          <button type="button" data-fb-next class="rounded-[var(--radius-control)] bg-[var(--color-accent)] px-5 py-3 font-semibold text-[var(--color-accent-ink)]">Next</button>
        </div>
      ) : (
        <div class="grid gap-4">
          {config.optIn.mode === "checkbox" && form.consent !== "none" && (
            <div class="flex items-start gap-3">
              <input type="checkbox" id={fieldId("consent")} name="consent" required={form.consent === "required"} aria-describedby={`${fieldId("consent")}-err`} class="mt-1 size-5" />
              <label for={fieldId("consent")} class="text-sm" set:html={inline(config.optIn.label)} />
              <p id={`${fieldId("consent")}-err`} class="text-sm text-[var(--color-error)]" data-fb-error="consent"></p>
            </div>
          )}
          <div class="cf-turnstile max-w-full" data-sitekey={config.turnstile?.siteKey} data-action={id} data-size="flexible"></div>
          <div class="flex gap-3">
            {steps.length > 1 && <button type="button" data-fb-back class="rounded-[var(--radius-control)] border border-[var(--color-field)] px-5 py-3">Back</button>}
            <button type="submit" class="rounded-[var(--radius-control)] bg-[var(--color-accent)] px-5 py-3 font-semibold text-[var(--color-accent-ink)]">{form.submitLabel || "Send"}</button>
          </div>
          {config.optIn.mode !== "checkbox" && form.consent !== "none" && <p class="text-sm text-[var(--color-ink-muted)]" set:html={inline(config.optIn.text)} />}
          {form.note && <p class="text-sm text-[var(--color-ink-muted)]" set:html={inline(form.note)} />}
        </div>
      )}
    </fieldset>
  ))}

  <div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden">
    <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <p role="status" aria-live="polite" data-fb-status class="text-sm"></p>
</form>

<script src="../scripts/form.js"></script>

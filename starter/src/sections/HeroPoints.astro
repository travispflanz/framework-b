---
// The hero's short reassurances (fb_hero), each with a tick.
import Icon from "./Icon.astro";

interface Props { points: string[]; onDark?: boolean; center?: boolean }
const { points, onDark = false, center = false } = Astro.props;
---
<ul class:list={["flex flex-wrap gap-x-6 gap-y-2 text-small", onDark ? "text-bg" : "text-ink", { "justify-center": center }]}>
  {points.map((p) => (
    <li class="flex items-center gap-2"><Icon name="check" class:list={["size-5 shrink-0", onDark ? "text-bg" : "text-accent"]} />{p}</li>
  ))}
</ul>

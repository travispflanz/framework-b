---
// fb_hero: the page's opening. The only section with an <h1>. Layouts:
//   split       text beside an optional image (the original layout)
//   full-bleed  the image fills the band behind the text, under a dark scrim
//   statement   the headline alone, with no picture (a photo goes with the title, never in a bare band under it)
//   editorial   an asymmetric spread: a tall image with the text set against it
//   bento       tiles: the headline, the image, each reassurance and the main action
//   fade        the photo fills the band's height on the right and fades into the background towards the headline (on
//               phones it sits above the headline and fades into it); the text stays on the plain background
// The poster route (docs/SPEC.md section 12, "The poster route"; styles in sections.css):
//   poster      the image across the full width, the headline enormous along the bottom edge, the supporting
//               sentence and actions on a scrim block above it (a home page's hero)
//   poster-page the poster hero, shorter, with the title a step smaller (an inner page's)
//   poster-card the title beside a photo in a 4:5 frame (a form page's: the form comes up quickly)
//   poster-edge the title beside a photo that runs to the edge of the window
import Actions from "./HeroActions.astro";
import Icon from "./Icon.astro";
import Points from "./HeroPoints.astro";
import Picture from "./Picture.astro";
import { accent, lines, inline, plain } from "./text.js";
import Eyebrow from "./Eyebrow.astro";
import { composition, variantOf } from "./design.js";
import { VARIANTS } from "./schema.js";

interface Props { value: Record<string, any>; blockKey?: string }
const { value } = Astro.props;
const points = lines(value.points).slice(0, 4);
const hasImage = !!value.image?.src;
// The route sets the hero (composition.heroes in DESIGN.md): one layout for the home page and a family for every
// other page (a page picks one with `variant`; without one it gets the first), so a page added later looks like the
// rest. A hero with no picture falls back to a statement, in the same title treatment (composition.titleCase and
// composition.align), so the page title reads the same on every page.
const route = composition.heroes ? (Astro.url.pathname.replace(/\/$/, "") === "" ? composition.heroes.home : [].concat(composition.heroes.page)[0]) : undefined;
const chosen = VARIANTS.fb_hero.includes(value.variant) ? value.variant : route || variantOf("fb_hero", value);
const variant = hasImage ? chosen : chosen === "bento" ? "bento" : "statement";
const center = composition.align === "center";
const onDark = variant === "full-bleed";
const titleCase = { uppercase: composition.titleCase === "upper" };
// The hero's eyebrow takes the title's case too, so every page opens with the same label.
const eyebrowCase = composition.titleCase === "upper" ? "uppercase" : undefined;
// A statement set left puts its text and buttons beside the title on wide screens, so a short title ("Thanks.")
// doesn't leave the right of the page empty (scripts/lib/cohesion.mjs, "balance").
const statementRest = !!(value.subheadline || value.primary_cta_label || value.secondary_cta_label || points.length);
const statementSplit = !center && statementRest;
// In the fade layout the title has under half the window, so a full sentence at display size runs to four lines and
// fills the first screen (Impeccable's oversized-h1: "set long headlines smaller"; the first adopted site, 2026-11-11).
// A headline longer than 40 characters is set a step smaller, at the headline size; face, weight and case stay the
// same as every other page's title.
const longTitle = plain(value.headline).length > 40;
---
{variant === "poster" || variant === "poster-page" ? (
  <section id={value.anchor_id || undefined} class:list={["panel panel-wide panel-hero", { "panel-page": variant === "poster-page" }]} data-side="left">
    <Picture image={value.image} sizes="100vw" class="panel-image" eager />
    <div class="panel-dim" aria-hidden="true"></div>
    <div class="panel-copy scrim-block grid gap-4">
      {value.eyebrow && <p class:list={["text-label text-on-scrim-muted", eyebrowCase]}>{value.eyebrow}</p>}
      {value.subheadline && <p class:list={["text-on-scrim", variant === "poster" ? "type-lede" : "text-body"]} set:html={inline(value.subheadline)} />}
      <Actions value={value} onScrim />
      {points.length > 0 && <Points points={points} onScrim />}
    </div>
    <h1 class:list={["panel-title font-display text-on-scrim", variant === "poster" ? "type-display-l" : "text-display", titleCase]} set:html={accent(value.headline)} />
  </section>
) : variant === "poster-card" ? (
  <section id={value.anchor_id || undefined} class="hero-card bg-surface px-gutter">
    <div class="hero-card-grid mx-auto w-full max-w-content">
      <div class="hero-card-copy grid content-end gap-6">
        {value.eyebrow && <Eyebrow text={value.eyebrow} class={eyebrowCase} />}
        <h1 class:list={["font-display text-display text-ink", titleCase]} set:html={accent(value.headline)} />
        {value.subheadline && <p class="max-w-(--container-prose) text-body text-ink-muted" set:html={inline(value.subheadline)} />}
        <Actions value={value} />
        {points.length > 0 && <Points points={points} />}
      </div>
      <div class="hero-card-photo"><Picture image={value.image} sizes="(min-width: 1024px) 34vw, 100vw" eager /></div>
    </div>
  </section>
) : variant === "poster-edge" ? (
  <section id={value.anchor_id || undefined} class="hero-edge bg-surface">
    <div class="hero-edge-photo"><Picture image={value.image} sizes="(min-width: 1024px) 40vw, 100vw" eager /></div>
    <div class="hero-edge-copy grid content-end gap-6 px-gutter">
      {value.eyebrow && <Eyebrow text={value.eyebrow} class={eyebrowCase} />}
      <h1 class:list={["font-display text-display text-ink", titleCase]} set:html={accent(value.headline)} />
      {value.subheadline && <p class="max-w-(--container-prose) text-body text-ink-muted" set:html={inline(value.subheadline)} />}
      <Actions value={value} />
      {points.length > 0 && <Points points={points} />}
    </div>
  </section>
) : variant === "full-bleed" ? (
  <section id={value.anchor_id || undefined} class="hero-bleed relative isolate overflow-hidden bg-ink px-gutter py-section">
    <Picture image={value.image} sizes="100vw" class="parallax absolute inset-0 -z-20 size-full object-cover" eager />
    <div class="hero-scrim absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class:list={["mx-auto grid w-full max-w-content gap-6 py-16", { "justify-items-center text-center": center }]}>
      {value.eyebrow && <p class="w-fit rounded-full bg-highlight px-3 py-1 text-label text-highlight-ink">{value.eyebrow}</p>}
      <h1 class:list={["max-w-[22ch] font-display text-display text-balance text-bg", titleCase]} set:html={accent(value.headline)} />
      {value.subheadline && <p class="max-w-(--container-prose) text-body text-bg" set:html={inline(value.subheadline)} />}
      <Actions value={value} onDark center={center} />
      {points.length > 0 && <Points points={points} onDark center={center} />}
    </div>
  </section>
) : variant === "statement" ? (
  <section id={value.anchor_id || undefined} class="bg-surface px-gutter pt-section">
    <div class:list={["reveal mx-auto grid w-full max-w-content gap-6", center ? "justify-items-center text-center" : statementSplit && "lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end lg:gap-x-16"]}>
      <div class:list={["grid gap-6", { "justify-items-center": center }]}>
        {value.eyebrow && <Eyebrow text={value.eyebrow} center={center} class={eyebrowCase} />}
        <h1 class:list={["font-display text-display text-ink", titleCase]} set:html={accent(value.headline)} />
      </div>
      {statementRest && (
        <div class:list={["grid gap-6", { "justify-items-center": center }]}>
          {value.subheadline && <p class="max-w-(--container-prose) text-body text-ink-muted" set:html={inline(value.subheadline)} />}
          <Actions value={value} center={center} />
          {points.length > 0 && <Points points={points} center={center} />}
        </div>
      )}
    </div>
    <div class="pb-section" />
  </section>
) : variant === "editorial" ? (
  <section id={value.anchor_id || undefined} class="bg-surface px-gutter py-section">
    <div class="mx-auto grid w-full max-w-content items-end gap-10 lg:grid-cols-12">
      <div class="reveal grid gap-6 lg:col-span-5 lg:pb-12">
        {value.eyebrow && <p class="border-l-4 border-accent pl-3 text-label text-ink">{value.eyebrow}</p>}
        <h1 class:list={["font-display text-display text-ink", titleCase]} set:html={accent(value.headline)} />
        {value.subheadline && <p class="max-w-(--container-prose) text-body text-ink-muted" set:html={inline(value.subheadline)} />}
        <Actions value={value} />
        {points.length > 0 && <Points points={points} />}
      </div>
      <div class="lg:col-span-7">
        <Picture image={value.image} sizes="(min-width: 1024px) 58vw, 100vw" class="media aspect-[4/5] w-full object-cover max-lg:aspect-[4/3]" eager />
      </div>
    </div>
  </section>
) : variant === "bento" ? (
  <section id={value.anchor_id || undefined} class="bg-surface px-gutter py-section">
    <div class="mx-auto grid w-full max-w-content gap-4 md:grid-cols-6">
      <div class="card grid content-end gap-5 p-8 md:col-span-4 md:row-span-2">
        {value.eyebrow && <Eyebrow text={value.eyebrow} center={center} class={eyebrowCase} />}
        <h1 class:list={["font-display text-display text-ink", titleCase]} set:html={accent(value.headline)} />
        {value.subheadline && <p class="max-w-(--container-prose) text-body text-ink-muted" set:html={inline(value.subheadline)} />}
      </div>
      {hasImage && <Picture image={value.image} sizes="(min-width: 768px) 33vw, 100vw" class="media aspect-[4/3] w-full object-cover md:col-span-2 md:row-span-2 md:aspect-auto md:h-full" eager />}
      {points.map((p) => (
        <p class="card flex items-center gap-3 p-5 text-small text-ink md:col-span-2"><Icon name="check" class="size-5 shrink-0 text-accent" /><span set:html={inline(p)} /></p>
      ))}
      {value.primary_cta_label && value.primary_cta_url && (
        <a href={value.primary_cta_url} class:list={["button-primary grid min-h-16 place-items-center p-5 text-center no-underline", points.length % 3 === 0 ? "md:col-span-6" : "md:col-span-2"]}>{value.primary_cta_label}</a>
      )}
    </div>
  </section>
) : variant === "fade" && hasImage ? (
  <section id={value.anchor_id || undefined} class="hero-fade relative isolate overflow-hidden bg-bg">
    <div class="hero-fade-photo">
      <Picture image={value.image} sizes="(min-width: 1024px) 60vw, 100vw" class="size-full object-cover" eager />
    </div>
    <div class="hero-fade-copy relative mx-auto grid w-full max-w-content content-end gap-6 px-gutter">
      <div class="reveal grid gap-6 lg:max-w-[46%]">
        {value.eyebrow && <Eyebrow text={value.eyebrow} class={eyebrowCase} />}
        <h1 class:list={["font-display text-balance text-ink", longTitle ? "text-headline" : "text-display", titleCase]} set:html={accent(value.headline)} />
        {value.subheadline && <p class="max-w-(--container-prose) text-body text-ink-muted" set:html={inline(value.subheadline)} />}
        <Actions value={value} />
        {points.length > 0 && <Points points={points} />}
      </div>
    </div>
  </section>
) : (
  <section id={value.anchor_id || undefined} class="bg-surface px-gutter py-section">
    <div class:list={["mx-auto grid w-full max-w-content items-center gap-10", { "lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]": hasImage }]}>
      <div class:list={["reveal grid gap-6", { "justify-items-center text-center": center && !hasImage }]}>
        {value.eyebrow && <p class="w-fit rounded-full bg-highlight px-3 py-1 text-label text-highlight-ink">{value.eyebrow}</p>}
        <h1 class:list={["max-w-[22ch] font-display text-display text-balance text-ink", titleCase]} set:html={accent(value.headline)} />
        {value.subheadline && <p class="max-w-(--container-prose) text-body text-ink-muted" set:html={inline(value.subheadline)} />}
        <Actions value={value} />
        {points.length > 0 && <Points points={points} />}
      </div>
      {hasImage && <Picture image={value.image} sizes="(min-width: 1024px) 45vw, 100vw" class="media aspect-[4/3] w-full object-cover" eager />}
    </div>
  </section>
)}

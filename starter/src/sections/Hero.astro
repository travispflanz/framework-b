---
// fb_hero: the page's opening. The only section with an <h1>. Layouts:
//   split       text beside an optional image (the original layout)
//   full-bleed  the image fills the band behind the text, under a dark scrim
//   statement   the headline alone, wide, with the image as a band underneath
//   editorial   an asymmetric spread: a tall image with the text set against it
//   bento       tiles: the headline, the image, each reassurance and the main action
import Actions from "./HeroActions.astro";
import Icon from "./Icon.astro";
import Points from "./HeroPoints.astro";
import Picture from "./Picture.astro";
import { lines, inline } from "./text.js";
import { isLabelled } from "./generated.js";
import { composition, variantOf } from "./design.js";

interface Props { value: Record<string, any>; blockKey?: string }
const { value } = Astro.props;
const points = lines(value.points).slice(0, 4);
const hasImage = !!value.image?.src;
const variant = hasImage ? variantOf("fb_hero", value) : variantOf("fb_hero", value) === "bento" ? "bento" : "statement";
const center = composition.align === "center" || variant === "statement";
const onDark = variant === "full-bleed";
---
{variant === "full-bleed" ? (
  <section id={value.anchor_id || undefined} class="hero-bleed relative isolate overflow-hidden bg-ink px-gutter py-section">
    <Picture image={value.image} sizes="100vw" class="parallax absolute inset-0 -z-20 size-full object-cover" eager label={false} />
    <div class="hero-scrim absolute inset-0 -z-10" aria-hidden="true"></div>
    {isLabelled(value.image) && <span data-generated-label class="absolute right-2 bottom-2 rounded-control bg-ink px-2 py-1 text-label text-bg max-sm:top-2 max-sm:bottom-auto">Generated image</span>}
    <div class:list={["mx-auto grid w-full max-w-content gap-6 py-16", { "justify-items-center text-center": center }]}>
      {value.eyebrow && <p class="w-fit rounded-full bg-highlight px-3 py-1 text-label text-highlight-ink">{value.eyebrow}</p>}
      <h1 class="max-w-[22ch] font-display text-display text-balance text-bg">{value.headline}</h1>
      {value.subheadline && <p class="max-w-(--container-prose) text-body text-bg" set:html={inline(value.subheadline)} />}
      <Actions value={value} onDark center={center} />
      {points.length > 0 && <Points points={points} onDark center={center} />}
    </div>
  </section>
) : variant === "statement" ? (
  <section id={value.anchor_id || undefined} class="bg-surface px-gutter pt-section">
    <div class:list={["reveal mx-auto grid w-full max-w-content gap-6", { "justify-items-center text-center": center }]}>
      {value.eyebrow && <p class="text-label text-accent">{value.eyebrow}</p>}
      <h1 class="font-display text-display text-ink">{value.headline}</h1>
      {value.subheadline && <p class="max-w-(--container-prose) text-body text-ink-muted" set:html={inline(value.subheadline)} />}
      <Actions value={value} center={center} />
      {points.length > 0 && <Points points={points} center={center} />}
    </div>
    {hasImage ? (
      <div class="mx-auto mt-12 w-full max-w-content">
        <Picture image={value.image} sizes="(min-width: 1088px) 68rem, 100vw" class="media aspect-[21/9] w-full object-cover max-sm:aspect-[4/3]" eager />
      </div>
    ) : <div class="pb-section" />}
  </section>
) : variant === "editorial" ? (
  <section id={value.anchor_id || undefined} class="bg-surface px-gutter py-section">
    <div class="mx-auto grid w-full max-w-content items-end gap-10 lg:grid-cols-12">
      <div class="reveal grid gap-6 lg:col-span-5 lg:pb-12">
        {value.eyebrow && <p class="border-l-4 border-accent pl-3 text-label text-ink">{value.eyebrow}</p>}
        <h1 class="font-display text-display text-ink">{value.headline}</h1>
        {value.subheadline && <p class="max-w-(--container-prose) text-body text-ink-muted" set:html={inline(value.subheadline)} />}
        <Actions value={value} />
        {points.length > 0 && <Points points={points} />}
      </div>
      <div class="lg:col-span-7">
        <Picture image={value.image} sizes="(min-width: 1024px) 58vw, 100vw" class="media aspect-[4/5] w-full object-cover max-lg:aspect-[4/3]" eager />
      </div>
    </div>
  </section>
) : variant === "bento" ? (
  <section id={value.anchor_id || undefined} class="bg-surface px-gutter py-section">
    <div class="mx-auto grid w-full max-w-content gap-4 md:grid-cols-6">
      <div class="card grid content-end gap-5 p-8 md:col-span-4 md:row-span-2">
        {value.eyebrow && <p class="text-label text-accent">{value.eyebrow}</p>}
        <h1 class="font-display text-display text-ink">{value.headline}</h1>
        {value.subheadline && <p class="max-w-(--container-prose) text-body text-ink-muted" set:html={inline(value.subheadline)} />}
      </div>
      {hasImage && <Picture image={value.image} sizes="(min-width: 768px) 33vw, 100vw" class="media aspect-[4/3] w-full object-cover md:col-span-2 md:row-span-2 md:aspect-auto md:h-full" eager />}
      {points.map((p) => (
        <p class="card flex items-center gap-3 p-5 text-small text-ink md:col-span-2"><Icon name="check" class="size-5 shrink-0 text-accent" /><span set:html={inline(p)} /></p>
      ))}
      {value.primary_cta_label && value.primary_cta_url && (
        <a href={value.primary_cta_url} class:list={["button-primary grid min-h-16 place-items-center p-5 text-center no-underline", points.length % 3 === 0 ? "md:col-span-6" : "md:col-span-2"]}>{value.primary_cta_label}</a>
      )}
    </div>
  </section>
) : (
  <section id={value.anchor_id || undefined} class="bg-surface px-gutter py-section">
    <div class:list={["mx-auto grid w-full max-w-content items-center gap-10", { "lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]": hasImage }]}>
      <div class:list={["reveal grid gap-6", { "justify-items-center text-center": center && !hasImage }]}>
        {value.eyebrow && <p class="w-fit rounded-full bg-highlight px-3 py-1 text-label text-highlight-ink">{value.eyebrow}</p>}
        <h1 class="max-w-[22ch] font-display text-display text-balance text-ink">{value.headline}</h1>
        {value.subheadline && <p class="max-w-(--container-prose) text-body text-ink-muted" set:html={inline(value.subheadline)} />}
        <Actions value={value} />
        {points.length > 0 && <Points points={points} />}
      </div>
      {hasImage && <Picture image={value.image} sizes="(min-width: 1024px) 45vw, 100vw" class="media aspect-[4/3] w-full object-cover" eager />}
    </div>
  </section>
)}

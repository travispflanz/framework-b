---
// fb_area: where the business works.
import Icon from "./Icon.astro";
import Section from "./Section.astro";
import SectionIntro from "./SectionIntro.astro";
import { lines, paragraphs } from "./text.js";

interface Props { value: Record<string, any>; blockKey?: string; tone?: "bg" | "surface" }
const { value, blockKey, tone } = Astro.props;
const headingId = `h-${blockKey || value.anchor_id || "area"}`;
---
<Section id={value.anchor_id} tone={tone} labelledby={headingId}>
  <SectionIntro eyebrow={value.eyebrow} headline={value.headline} subheadline={value.body} id={headingId} />
  <ul class="flex flex-wrap gap-3">
    {lines(value.places).map((place) => (
      <li class="card flex items-center gap-2 px-4 py-2 text-small text-ink"><Icon name="map-pin" class="size-4 shrink-0 text-accent" />{place}</li>
    ))}
  </ul>
  {value.note && paragraphs(value.note).map((p) => <p class="mt-6 max-w-prose text-small text-ink-muted">{p}</p>)}
</Section>

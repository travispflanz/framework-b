---
// fb_features: reasons to choose the business, each with an icon.
import Icon from "./Icon.astro";
import Section from "./Section.astro";
import SectionIntro from "./SectionIntro.astro";

interface Props { value: Record<string, any>; blockKey?: string; tone?: "bg" | "surface" }
const { value, blockKey, tone } = Astro.props;
const headingId = `h-${blockKey || value.anchor_id || "features"}`;
---
<Section id={value.anchor_id} tone={tone} labelledby={headingId}>
  <SectionIntro eyebrow={value.eyebrow} headline={value.headline} subheadline={value.subheadline} id={headingId} />
  <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {value.items.map((item) => (
      <li class="grid content-start gap-3">
        <Icon name={item.icon} class="size-8 text-accent" />
        <h3 class="font-display text-title text-ink">{item.title}</h3>
        <p class="text-body text-ink-muted">{item.body}</p>
      </li>
    ))}
  </ul>
</Section>

---
// fb_people: the people behind the business. Photos are the owner's own (credited "owner" in design/credits.json);
// never stock or generated faces. Layouts: "grid" (photo cards) or "row" (photo beside each person's text).
import Picture from "./Picture.astro";
import Section from "./Section.astro";
import SectionIntro from "./SectionIntro.astro";
import { paragraphs, inline } from "./text.js";
import { phoneOf, variantOf } from "./design.js";

interface Props { value: Record<string, any>; blockKey?: string; tone?: "bg" | "surface" }
const { value, blockKey, tone } = Astro.props;
const headingId = `h-${blockKey || value.anchor_id || "people"}`;
const row = variantOf("fb_people", value) === "row";
const count = value.people.length;
---
<Section id={value.anchor_id} tone={tone} labelledby={headingId} phone={phoneOf("fb_people", value)}>
  <SectionIntro eyebrow={value.eyebrow} headline={value.headline} id={headingId} />
  {value.body && <div class="reveal mb-10 grid max-w-prose gap-4 text-body text-ink">{paragraphs(value.body).map((p) => <p set:html={inline(p)} />)}</div>}
  <ul class:list={["grid gap-8", row ? "max-w-prose" : { "sm:grid-cols-2": count > 1, "lg:grid-cols-3": count > 2 }]} data-reveal>
    {value.people.map((person) => (
      <li class:list={[row ? "grid items-start gap-5 sm:grid-cols-[10rem_1fr]" : "grid content-start gap-4"]}>
        {person.image?.src && <Picture image={person.image} sizes={row ? "10rem" : "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"} class="media aspect-[4/3] w-full object-cover" />}
        <div class="grid content-start gap-1">
          <p class="font-display text-title text-ink">{person.name}</p>
          {person.role && <p class="text-small text-ink-muted" set:html={inline(person.role)} />}
          {person.bio && <div class="mt-2 grid gap-3 text-body text-ink-muted">{paragraphs(person.bio).map((p) => <p set:html={inline(p)} />)}</div>}
        </div>
      </li>
    ))}
  </ul>
  {value.note && <div class="mt-10 grid max-w-prose gap-4 text-body text-ink">{paragraphs(value.note).map((p) => <p set:html={inline(p)} />)}</div>}
</Section>

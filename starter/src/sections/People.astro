---
// fb_people: the people behind the business. Photos are the owner's own (credited "owner" in design/credits.json);
// never stock or generated faces. Layouts: "grid" (photo cards; any text beside the headline), "row" (photo beside each
// person's text, centred) or "aside" (the text in a column with the photos beside it on wide screens).
import Picture from "./Picture.astro";
import Section from "./Section.astro";
import SectionIntro from "./SectionIntro.astro";
import { paragraphs, inline } from "./text.js";
import { phoneOf, variantOf } from "./design.js";

interface Props { value: Record<string, any>; blockKey?: string; tone?: "bg" | "surface" }
const { value, blockKey, tone } = Astro.props;
const headingId = `h-${blockKey || value.anchor_id || "people"}`;
const variant = variantOf("fb_people", value);
const row = variant === "row";
const aside = variant === "aside";
const count = value.people.length;
const body = value.body ? paragraphs(value.body) : [];
// Aside: the photos stack in one column beside a long text (about 600 characters a person keeps the two sides level),
// and sit two to a row beside a short one.
const stackAside = count > 1 && body.join(" ").length >= 600 * count;
---
<Section id={value.anchor_id} tone={tone} labelledby={headingId} phone={phoneOf("fb_people", value)}>
  {aside ? (
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-x-16">
      <div class="grid content-start gap-6">
        <SectionIntro eyebrow={value.eyebrow} headline={value.headline} id={headingId} center={false} flush />
        <div class="reveal grid max-w-(--container-prose) gap-4 text-body text-ink">{body.map((p) => <p set:html={inline(p)} />)}</div>
      </div>
      <ul class:list={["grid gap-8 lg:sticky lg:top-8", { "sm:grid-cols-2": count > 1, "lg:grid-cols-1": stackAside }]} data-reveal>
        {value.people.map((person) => (
          <li class="grid content-start gap-3">
            {person.image?.src && <Picture image={person.image} sizes={stackAside || count === 1 ? "(min-width: 1024px) 38vw, (min-width: 640px) 50vw, 100vw" : "(min-width: 1024px) 19vw, 50vw"} class="media aspect-[4/3] w-full object-cover" />}
            <div class="grid content-start gap-1">
              <p class="font-display text-title text-ink">{person.name}</p>
              {person.role && <p class="text-small text-ink-muted" set:html={inline(person.role)} />}
              {person.bio && <div class="mt-2 grid gap-3 text-body text-ink-muted">{paragraphs(person.bio).map((p) => <p set:html={inline(p)} />)}</div>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  ) : (
  <>
  <div class:list={{ "split-row": body.length > 0 && !row, "mb-10": body.length > 0 }}>
    <SectionIntro eyebrow={value.eyebrow} headline={value.headline} id={headingId} side={body.length > 0 && !row} />
    {body.length > 0 && <div class="reveal grid max-w-(--container-prose) gap-4 text-body text-ink">{body.map((p) => <p set:html={inline(p)} />)}</div>}
  </div>
  <ul class:list={["grid gap-8", row ? "mx-auto max-w-(--container-prose)" : { "sm:grid-cols-2": count > 1, "lg:grid-cols-3": count > 2 }]} data-reveal>
    {value.people.map((person) => (
      <li class:list={[row ? "grid items-start gap-5 sm:grid-cols-[10rem_1fr]" : "grid content-start gap-4"]}>
        {person.image?.src && <Picture image={person.image} sizes={row ? "10rem" : "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"} class="media aspect-[4/3] w-full object-cover" />}
        <div class="grid content-start gap-1">
          <p class="font-display text-title text-ink">{person.name}</p>
          {person.role && <p class="text-small text-ink-muted" set:html={inline(person.role)} />}
          {person.bio && <div class="mt-2 grid gap-3 text-body text-ink-muted">{paragraphs(person.bio).map((p) => <p set:html={inline(p)} />)}</div>}
        </div>
      </li>
    ))}
  </ul>
  </>
  )}
  {value.note && <div class="wide-body mx-auto mt-10 w-full text-body text-ink lg:w-4/5">{paragraphs(value.note).map((p) => <p set:html={inline(p)} />)}</div>}
</Section>

---
// fb_faq: questions whose answers open in place (<details>, no JavaScript), one open at a time. Layouts: "stack"
// (the introduction above the questions) or "two-column" (the introduction stays beside the questions).
import Section from "./Section.astro";
import SectionIntro from "./SectionIntro.astro";
import { paragraphs, inline } from "./text.js";
import { phoneOf, variantOf } from "./design.js";

interface Props { value: Record<string, any>; blockKey?: string; tone?: "bg" | "surface" }
const { value, blockKey, tone } = Astro.props;
const headingId = `h-${blockKey || value.anchor_id || "faq"}`;
const variant = variantOf("fb_faq", value);
const phone = phoneOf("fb_faq", value);
---
<Section id={value.anchor_id} tone={tone} labelledby={headingId} phone={phone}>
  <div class:list={{ "grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]": variant === "two-column" }}>
    <div class:list={{ "lg:sticky lg:top-24 lg:self-start": variant === "two-column" }}>
      <SectionIntro eyebrow={value.eyebrow} headline={value.headline} subheadline={value.subheadline} id={headingId} center={false} />
    </div>
    <div class="grid max-w-(--container-prose) gap-3" data-reveal>
      {value.items.map((item) => (
        <details name={`${headingId}-q`} class="card group p-0">
          <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 text-title text-ink [&::-webkit-details-marker]:hidden">
            <span class="font-display">{item.question}</span>
            <span class="text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="grid gap-3 px-5 pb-5 text-body text-ink-muted">
            {paragraphs(item.answer).map((p) => <p set:html={inline(p)} />)}
          </div>
        </details>
      ))}
    </div>
  </div>
</Section>

---
import Eyebrow from "./Eyebrow.astro";
import { accent, inline, paragraphs } from "./text.js";
// The eyebrow, headline and supporting sentence most sections start with.
import { composition } from "./design.js";

// side: the intro is the left column of a split row (scripts/lib/cohesion.mjs, "balance"): it stays in view beside the
// content on wide screens and sits above it on phones. flush: the intro heads a column of its own, with no margin
// under it and no stickiness (text follows it in the same column).
interface Props { eyebrow?: string; headline?: string; subheadline?: string; id?: string; center?: boolean; side?: boolean; flush?: boolean }
const { eyebrow, headline, subheadline, id, side = false, flush = false } = Astro.props;
const center = side ? false : (Astro.props.center ?? composition.align === "center");
---
{(eyebrow || headline || subheadline) && (
  <div class:list={["reveal grid content-start gap-3", side ? "lg:sticky lg:top-8" : flush ? "max-w-(--container-prose)" : "mb-10 max-w-(--container-prose)", { "mx-auto text-center": center }]}>
    {eyebrow && <Eyebrow text={eyebrow} center={center} />}
    {headline && <h2 id={id} class="font-display text-headline text-ink" set:html={accent(headline)} />}
    {subheadline && paragraphs(subheadline).map((p) => <p class="text-body text-ink-muted" set:html={inline(p)} />)}
  </div>
)}

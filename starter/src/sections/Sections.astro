---
// Renders a page's sections in order. Content comes from src/content/<page>.json, or from EmDash when client
// editing is on; both use the same shape: [{ _type: "fb_hero", _key: "...", ...fields }].
// With composition.separation "bands" (DESIGN.md), bands alternate between the page background and the surface tone,
// starting after the hero; with "hairlines" or "none" every band uses the page background.
import Area from "./Area.astro";
import Cta from "./Cta.astro";
import Faq from "./Faq.astro";
import Gallery from "./Gallery.astro";
import Features from "./Features.astro";
import FormSection from "./FormSection.astro";
import Hero from "./Hero.astro";
import List from "./List.astro";
import People from "./People.astro";
import Pricing from "./Pricing.astro";
import Split from "./Split.astro";
import Steps from "./Steps.astro";
import Text from "./Text.astro";
import { composition } from "./design.js";

const COMPONENTS = { fb_hero: Hero, fb_steps: Steps, fb_features: Features, fb_pricing: Pricing, fb_area: Area, fb_faq: Faq, fb_cta: Cta, fb_form: FormSection, fb_text: Text, fb_split: Split, fb_gallery: Gallery, fb_list: List, fb_people: People };

interface Props { sections: Array<Record<string, any>> }
const { sections = [] } = Astro.props;
let band = 0;
const items = sections.map((value, i) => {
  const Component = COMPONENTS[value._type];
  if (!Component) throw new Error(`Unknown section type "${value._type}"`);
  const tone = value._type === "fb_hero" ? undefined : composition.separation !== "bands" ? "bg" : band++ % 2 === 0 ? "bg" : "surface";
  return { Component, value, key: value._key || `s${i}`, tone };
});
---
{items.map(({ Component, value, key, tone }) => <Component value={value} blockKey={key} tone={tone} />)}

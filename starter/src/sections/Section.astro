---
// Full-width band with the content column inside. `tone` picks the band's background from the tokens; the
// composition's `separation` (DESIGN.md) decides whether bands alternate, sit between hairlines or run together.
// `phone: "hide"` removes the section on phones (under 640 px). `inverse` (the poster route) swaps in DESIGN.md's
// `inverse-*` colours for one light band in a dark design, or one dark band in a light one (sections.css).
import { composition } from "./design.js";

interface Props { id?: string; tone?: "bg" | "surface" | "inverse"; labelledby?: string; phone?: string; class?: string }
const { id, tone = "bg", labelledby, phone, class: extra } = Astro.props;
---
<section
  id={id || undefined}
  aria-labelledby={labelledby}
  class:list={[
    "px-gutter py-section scroll-mt-20",
    tone === "surface" ? "bg-surface" : "bg-bg",
    { "tone-inverse": tone === "inverse", "border-t border-line": composition.separation === "hairlines", "max-sm:hidden": phone === "hide" },
    extra,
  ]}
>
  <div class="mx-auto w-full max-w-content">
    <slot />
  </div>
</section>

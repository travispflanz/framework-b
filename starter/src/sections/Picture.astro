---
// One image from a section's image field. The value has EmDash's media shape ({ src, alt, ... }).
// On a static site `src` is a file name in src/assets/images/: Astro resizes it to WebP at several widths and the
// browser picks one (`sizes`). Any other src (an EmDash media URL) renders as a plain <img>.
// Every image in src/assets/images/ needs a credit in design/credits.json (scripts/check-content.mjs); generated
// images are listed on /credits and carry no label on the page (docs/DECISIONS.md, 2026-10-28).
// A focal point keeps the subject in view wherever a layout crops the picture (a wide band, a card, a phone
// screen): `focalX` and `focalY` are shares of the width and height from 0 to 1, the same two fields EmDash's
// media library stores, so a point set by an editor works too. Without one the picture is cropped about its centre.
import { Image } from "astro:assets";

interface Props { image: { src?: string; alt?: string; width?: number; height?: number; focalX?: number; focalY?: number }; sizes: string; class?: string; eager?: boolean }
const { image, sizes, class: className = "", eager = false } = Astro.props;
const local = import.meta.glob<{ default: ImageMetadata }>("/src/assets/images/*.{jpg,jpeg,png,webp,avif}", { eager: true });
const asset = image?.src ? local[`/src/assets/images/${image.src}`]?.default : undefined;
if (image?.src && !asset && !/^(https?:)?\/\//.test(image.src)) throw new Error(`Image "${image.src}" is not in src/assets/images/`);
const widths = asset ? [480, 800, 1200, 1600].filter((w) => w <= asset.width) : [];
const share = (v: unknown) => (typeof v === "number" && v >= 0 && v <= 1 ? `${Math.round(v * 1000) / 10}%` : "50%");
const focal = typeof image?.focalX === "number" || typeof image?.focalY === "number" ? `object-position: ${share(image.focalX)} ${share(image.focalY)}` : undefined;
---
{asset ? (
  <Image src={asset} alt={image.alt || ""} widths={widths} sizes={sizes} class={className} style={focal} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined} />
) : image?.src ? (
  <img src={image.src} alt={image.alt || ""} width={image.width} height={image.height} class={className} style={focal} loading={eager ? "eager" : "lazy"} decoding="async" />
) : null}

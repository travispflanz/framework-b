---
// fb_pricing: up to three plans. Prices are shown in full; small print sits under the plans.
import Icon from "./Icon.astro";
import Section from "./Section.astro";
import SectionIntro from "./SectionIntro.astro";
import { lines, paragraphs, inline } from "./text.js";
import { phoneOf } from "./design.js";

interface Props { value: Record<string, any>; blockKey?: string; tone?: "bg" | "surface" }
const { value, blockKey, tone } = Astro.props;
const headingId = `h-${blockKey || value.anchor_id || "pricing"}`;
const phone = phoneOf("fb_pricing", value) === "collapse" ? "stack" : phoneOf("fb_pricing", value);
---
<Section id={value.anchor_id} tone={tone} labelledby={headingId} phone={phone}>
  <SectionIntro eyebrow={value.eyebrow} headline={value.headline} subheadline={value.subheadline} id={headingId} />
  <ul class="phone-list grid gap-6 md:grid-cols-[repeat(auto-fit,minmax(16rem,1fr))]" data-phone={phone} tabindex={phone === "swipe" ? 0 : undefined} aria-label={phone === "swipe" ? value.headline : undefined} data-reveal>
    {value.plans.map((plan) => (
      <li class:list={["card relative grid content-start gap-4 p-6", { "outline-3 outline-accent": plan.highlighted }]}>
        {plan.badge && <p class="w-fit rounded-full bg-highlight px-3 py-1 text-label text-highlight-ink">{plan.badge}</p>}
        <h3 class="font-display text-title text-ink">{plan.name}</h3>
        <p class="flex items-baseline gap-2">
          <span class="font-display text-headline text-ink">{plan.price}</span>
          {plan.period && <span class="text-small text-ink-muted">{plan.period}</span>}
        </p>
        {plan.description && <p class="text-body text-ink-muted">{plan.description}</p>}
        {plan.features && (
          <ul class="grid gap-2 text-small text-ink">
            {lines(plan.features).map((f) => (
              <li class="flex gap-2"><Icon name="check" class="mt-0.5 size-5 shrink-0 text-accent" />{f}</li>
            ))}
          </ul>
        )}
        <a href={plan.cta_url} class="button-primary mt-2 inline-flex min-h-12 items-center justify-center no-underline">{plan.cta_label}</a>
      </li>
    ))}
  </ul>
  {value.note && paragraphs(value.note).map((p) => <p class="mt-6 max-w-(--container-prose) text-small text-ink-muted" set:html={inline(p)} />)}
</Section>

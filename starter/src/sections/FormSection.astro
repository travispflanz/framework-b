---
// fb_form: one of the site's forms, with an introduction. Layouts: "split" (the introduction beside the form on wide
// screens; without an introduction the form is centred) or "stacked" (the introduction above the form, both centred).
import Form from "../components/Form.astro";
import Section from "./Section.astro";
import SectionIntro from "./SectionIntro.astro";
import { phoneOf, variantOf } from "./design.js";

interface Props { value: Record<string, any>; blockKey?: string; tone?: "bg" | "surface" }
const { value, blockKey, tone } = Astro.props;
const headingId = `h-${blockKey || value.anchor_id || "form"}`;
// Split needs an introduction to put beside the form; without one the form is centred.
const split = variantOf("fb_form", value) === "split" && !!(value.headline || value.eyebrow || value.subheadline);
---
<Section id={value.anchor_id} tone={tone} labelledby={value.headline ? headingId : undefined} phone={phoneOf("fb_form", value)}>
  <div class:list={split ? "grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]" : "mx-auto max-w-(--container-prose)"}>
    <SectionIntro eyebrow={value.eyebrow} headline={value.headline} subheadline={value.subheadline} id={headingId} side={split} center={!split} />
    <div class:list={{ "card p-6 sm:p-8": split }}><Form id={value.form} showTitle={false} stepHeading={value.headline ? "h3" : "h2"} /></div>
  </div>
</Section>

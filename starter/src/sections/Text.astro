---
// fb_text: plain paragraphs under a headline. Layouts: "prose" or "lead" (the first paragraph set larger).
import Section from "./Section.astro";
import SectionIntro from "./SectionIntro.astro";
import { paragraphs } from "./text.js";
import { phoneOf, variantOf } from "./design.js";

interface Props { value: Record<string, any>; blockKey?: string; tone?: "bg" | "surface" }
const { value, blockKey, tone } = Astro.props;
const headingId = `h-${blockKey || value.anchor_id || "text"}`;
const lead = variantOf("fb_text", value) === "lead";
---
<Section id={value.anchor_id} tone={tone} labelledby={value.headline ? headingId : undefined} phone={phoneOf("fb_text", value)}>
  <SectionIntro eyebrow={value.eyebrow} headline={value.headline} id={headingId} />
  <div class="reveal grid max-w-prose gap-4 text-body text-ink">
    {paragraphs(value.body).map((p, i) => <p class:list={{ "font-display text-title": lead && i === 0 }}>{p}</p>)}
  </div>
</Section>

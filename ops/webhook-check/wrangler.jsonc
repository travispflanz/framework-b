// A test receiver for the CRM webhook (see src/index.js and README.md). Deployed by hand when a webhook test is
// needed: npx wrangler deploy, then npx wrangler secret put CRM_WEBHOOK_SECRET.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "framework-b-webhook-check",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "RESULTS", "id": "<results-kv-id>" }],
  "observability": { "enabled": true }
}

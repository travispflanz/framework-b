// Deployed by .github/workflows/deploy-backup-worker.yml. ACCOUNT_ID and the D1_BACKUP_TOKEN secret are set there.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "framework-backups",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "workflows": [
    {
      "name": "framework-backups",
      "binding": "BACKUP",
      "class_name": "BackupWorkflow"
    }
  ],
  // Mondays 06:17 UTC. Cloudflare counts weekdays from 1 = Sunday, so the day is written MON: "* * 1" ran on
  // Sundays (https://developers.cloudflare.com/workers/configuration/cron-triggers/, checked 2026-10-27). A Worker Cron Trigger starts the Workflow: Workflow "schedules" need a paid plan
  // (deploy error, 2026-10-22), while Cron Triggers are on the Free plan (5 per account).
  "triggers": { "crons": ["17 6 * * MON"] },
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "framework-backups" }],
  "observability": { "enabled": true }
}

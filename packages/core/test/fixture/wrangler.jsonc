{
  "name": "core-test",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/admin", "/admin/*", "/u", "/go", "/go/"] },
  "d1_databases": [{ "binding": "DB", "database_name": "test", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../migrations" }],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "test-uploads" }],
  "workflows": [{ "name": "core-test-drips", "binding": "DRIPS", "class_name": "DripWorkflow" }],
  "ratelimits": [{ "name": "SUBMIT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": {
    "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA",
    "SIGNING_SECRET": "test-signing-secret-at-least-32-characters-long",
    "MAILER_URL": "https://script.google.com/macros/s/TEST/exec",
    "MAILER_SECRET": "test-mailer-secret",
    "RESEND_API_KEY": "re_test_key",
    "ACCESS_TEAM_DOMAIN": "example.cloudflareaccess.com",
    "ACCESS_AUD": "test-aud"
  }
}
